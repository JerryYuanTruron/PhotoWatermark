# ---- Python 中间产物 ----
__pycache__/
*.py[cod]
*.egg-info/

# ---- 运行时 / 自测生成（项目根下所有 _ 前缀临时目录与文件）----
/_*
rules/last_used.json
logs/
*.log

# ---- 构建产物：exe / BUILD_INFO 均为可重建的构建产物，不入库 ----
# 源码版本管理 + tag 指向构建时的提交；BUILD_INFO.txt 记录该提交号与 exe sha256 以便回溯。
# 需要二进制时运行 build_exe.bat 重新生成（同一提交可复现）。
build/
dist/*
!dist/.gitkeep

# ---- 操作系统 ----
Thumbs.db
Desktop.ini
.DS_Store
